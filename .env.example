# The site's own address, for canonical links, share cards, the sitemap and e-mail links. No trailing slash.
SITE_URL=https://vrikshabandhanabhiyan.in
# Public Supabase settings. Leave both unset to run without a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local seeding only (npm run seed). Never deploy this.
# SUPABASE_SERVICE_ROLE_KEY=

# Newsletter (all server-only). Leave all unset and the site runs with the subscribe form saying "not open yet".
# The Resend API key ("Sending access" is enough).
RESEND_API_KEY=
# A random secret, `openssl rand -hex 32`; the same value goes into private.newsletter_config (docs/deploy.md, 6).
NEWSLETTER_SECRET=
# The bare sending address. Test mode: onboarding@resend.dev. Live: stories@vrikshabandhanabhiyan.in once verified.
NEWSLETTER_FROM=
# While set, every mail goes only here (your own inbox) and sends are recorded as tests. Delete it to go live.
NEWSLETTER_TEST_TO=
